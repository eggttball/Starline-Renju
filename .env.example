# 預設不需設定任何金鑰、endpoint 或 model，伺服器會直接使用內建融合連珠引擎（local-engine）。
# 只有當 AI_API_ENABLED=true 時，才會啟用外部遠端 API（不要提交真實金鑰）。
AI_API_ENABLED=false

# 以下僅在 AI_API_ENABLED=true 時需要設定：
AI_API_KEY=

# 完整 endpoint，包含 API 路徑；adapter 不會自動補上路徑。
# openai-chat 範例：https://api.openai.com/v1/chat/completions
# openai-responses 範例：https://api.openai.com/v1/responses
# agent-json 請填你的自訂 agent JSON endpoint。
AI_API_ENDPOINT=

# openai-chat 與 openai-responses 需要 model；agent-json 或預設本地引擎皆可留空。
AI_API_MODEL=

# local-engine（預設）| agent-json | openai-chat | openai-responses
# 啟用遠端 API（AI_API_ENABLED=true）時預設為 openai-chat，並以 Authorization: Bearer <AI_API_KEY> 傳送金鑰。
# agent-json 傳送 {rules,board,moves,color,legalMoves,request}。
# 自訂 agent 回傳 {"move":{"row":0,"col":0},"reason":"說明","winRate":0.5}。
# row / col 為 0–14 整數；reason 最多 1000 字元。
# winRate 是目前行動方（color: black / white）下這一步後的最新勝率估計（0–1），不是實測統計。
# 提供 preferredMove 時必須回傳同一落點，並重新估計其 winRate。
# 私人記憶儲存在 .renju-data/ai-book.json；不公開服務，也不提交 Git。
AI_API_FORMAT=local-engine

# 僅允許本機地址；預設 http://127.0.0.1:3000。
HOST=127.0.0.1
PORT=3000
